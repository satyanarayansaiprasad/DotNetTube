@{
    ViewData["Title"] = "Terms and Conditions";
}

<section class="section" style="padding-top: 6rem;">
    <div class="container-xl">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <h1 class="display-4 mb-4 text-white">Terms and Conditions</h1>
                <p class="text-muted mb-4">Last Updated: @DateTime.UtcNow.ToString("MMMM dd, yyyy")</p>

                <div class="section-card">
                    <h2>1. Acceptance of Terms</h2>
                    <p>By accessing and using DotNetTube, you accept and agree to be bound by the terms and provision of this agreement. If you do not agree to these terms, please do not use our service.</p>

                    <h2>2. Description of Service</h2>
                    <p>DotNetTube provides comprehensive .NET learning materials including structured notes, practice questions, video references, and study guides. All content is delivered digitally through instant download after purchase.</p>

                    <h2>3. Purchase and Payment</h2>
                    <p>All purchases are processed through Razorpay payment gateway. Prices are displayed in Indian Rupees (INR). Once payment is confirmed, you will receive instant access to download your purchased materials.</p>

                    <h2>4. Digital Product Delivery</h2>
                    <p>All products are digital downloads. No physical products will be shipped. After successful payment, you will receive download links via email and can access your purchase through your account.</p>

                    <h2>5. Intellectual Property</h2>
                    <p>All content, materials, and resources provided by DotNetTube are protected by copyright and intellectual property laws. You are granted a personal, non-transferable license to use the materials for your own learning purposes only.</p>

                    <h2>6. Prohibited Uses</h2>
                    <p>You may not:</p>
                    <ul>
                        <li>Share, redistribute, or resell the materials</li>
                        <li>Use the content for commercial training purposes without authorization</li>
                        <li>Reverse engineer or extract source code from provided materials</li>
                        <li>Remove copyright notices or proprietary markings</li>
                    </ul>

                    <h2>7. Refund Policy</h2>
                    <p>Due to the digital nature of our products, all sales are final. Please review our <a href="@Url.Action("ReturnPolicy")">Return Policy</a> for detailed information.</p>

                    <h2>8. Limitation of Liability</h2>
                    <p>DotNetTube shall not be liable for any indirect, incidental, special, or consequential damages arising from the use of our materials or services.</p>

                    <h2>9. Modifications to Terms</h2>
                    <p>We reserve the right to modify these terms at any time. Continued use of our service after changes constitutes acceptance of the new terms.</p>

                    <h2>10. Contact Information</h2>
                    <p>For questions about these Terms and Conditions, please contact us through our website or email support.</p>

                </div>
            </div>
        </div>
    </div>
</section>

@await Html.PartialAsync("_Footer")

